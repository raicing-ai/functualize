"""Domain metadata for the {{ display_name }} SDK."""

from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True)
class DomainMetadata:
    """Self-describing metadata for a domain SDK."""

    name: str
    display_name: str
    description: str
    capability_class: str
    provider_protocol: str
    config_section: str
    entry_point_group: str
    events_prefix: str
    scaffold_template: str | None = None
    documentation_url: str | None = None
    mock_factory: str | None = None


domain_metadata = DomainMetadata(
    name="{{ domain_name }}",
    display_name="{{ display_name }}",
    description="{{ display_name }} capabilities",
    capability_class="functualize_{{ domain_name }}.{{ class_name }}Provider",
    provider_protocol="functualize_{{ domain_name }}.{{ class_name }}Provider",
    config_section="{{ domain_name }}",
    entry_point_group="functualize.{{ domain_name }}_providers",
    events_prefix="{{ domain_name }}.",
    scaffold_template=None,
    documentation_url=None,
    mock_factory=None,
)
