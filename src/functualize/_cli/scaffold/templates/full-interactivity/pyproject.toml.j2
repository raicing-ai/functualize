[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "A CLI application demonstrating all functualize interactivity plugins"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "functualize[cli]>=0.1.0",
    "functualize-inline>=0.1.0",
    "functualize-flow-viz>=0.1.0",
    "functualize-state-sqlite>=0.1.0",
]

[project.scripts]
{{ project_name }} = "{{ package_name }}.main:run"

[project.entry-points."functualize.plugins"]
inline = "functualize_inline.plugin:InlinePlugin"
flow-viz = "functualize_flow_viz.plugin:FlowVizPlugin"
execution-state = "functualize_state_sqlite:SQLiteStatePlugin"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.functualize.discovery]
require_file_import = "functualize"
# Alternative filter options (uncomment to enable):
# require_file_prefix = "job_"
# require_file_postfix = "_task"
# require_file_marker = "__functualize__"
# require_job_decorators = ["job"]
# exclude_patterns = ["**/test_*.py", "**/migrations/*.py"]
