"""Job module: events — demonstrates event-driven patterns.

Shows how to use rc.events.emit() to publish structured events that
other plugins and subscribers can react to.
"""

from pydantic import BaseModel, Field

from functualize.job.context import RunContext, RunStatus

JOB_GROUP = "events"


class EventsConfig(BaseModel):
    """Configuration schema for the events job."""

    resource: str = Field(default="data.csv", description="Resource to process")
    notify: bool = Field(default=True, description="Emit notification events")


def run(config: EventsConfig, rc: RunContext) -> None:
    """Execute the events job demonstrating rc.events.emit().

    This job shows how to publish structured events using rc.events.emit().
    Events are delivered to all registered EventBus subscribers and
    OutputRenderers, enabling decoupled observation of job progress.
    """
    rc.log(f"Starting events job for resource: {config.resource}")

    # Emit a lifecycle event — subscribers can react to job start
    rc.events.emit("job.started", resource=config.resource)

    rc.events.track_phase("load", "Loading resource", RunStatus.RUNNING)
    rc.events.emit("resource.loading", resource=config.resource, phase="start")

    # Simulate resource processing
    rc.log(f"Loaded resource: {config.resource}")
    rc.events.emit("resource.loading", resource=config.resource, phase="complete")
    rc.events.track_phase("load", "Resource loaded", RunStatus.SUCCESS)

    rc.events.track_phase("transform", "Transforming data", RunStatus.RUNNING)
    rc.events.emit("data.transform", resource=config.resource, records=42)
    rc.log("Transformed 42 records")
    rc.events.track_phase("transform", "Transform complete", RunStatus.SUCCESS)

    # Emit completion event with summary payload
    if config.notify:
        rc.events.emit(
            "job.completed",
            resource=config.resource,
            records_processed=42,
            status="success",
        )

    rc.events.track_run_status(RunStatus.SUCCESS)
    rc.log("Events job completed")
