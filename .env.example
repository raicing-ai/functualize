# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# Every backend below is OPTIONAL. A probe whose credentials are absent must SKIP,
# not fail: a contributor with no cloud account runs the suite green.

# --- Cloudflare D1 ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=          # needs D1 Read + D1 Write

# --- AWS (S3 + DynamoDB) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FUNCTUALIZE_PROBE_S3_BUCKET=
FUNCTUALIZE_PROBE_DDB_TABLE=

# --- Local emulator (floci / LocalStack-compatible), optional ---
# An emulator may back a `measured (emulator)` row. It may NEVER back a shipped
# StoreProfile field — see FUN-25.
AWS_ENDPOINT_URL=              # e.g. http://localhost:4566

# --- Cloudflare R2 (S3-API-compatible) ---
# Owns FUN-25's open question 1: is a conditional PutObject atomic under
# concurrent writers? R2 speaks S3's API, which is not the same as making S3's
# guarantees, and there is no R2 emulator — so without these the question stays
# NOT MEASURED. One bucket closes it.
FUNCTUALIZE_PROBE_R2_ENDPOINT=         # https://<account-id>.r2.cloudflarestorage.com
FUNCTUALIZE_PROBE_R2_ACCESS_KEY_ID=
FUNCTUALIZE_PROBE_R2_SECRET_ACCESS_KEY=
FUNCTUALIZE_PROBE_R2_BUCKET=

# --- Tier C, lowest priority ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SUPABASE_DB_URL=

# --- Jev / System One (decision provider) ---
# Backs the decision-provider capability probe's `measured (real service)` rows:
# the provider's request/response contract, its scoring identities, the
# stability of its decisions, its token cost, and its error taxonomy.
# The probe calls the free model by name and never tops the account up, so this
# key buys measurement and nothing else. Without it every one of those rows
# stays NOT MEASURED and the suite stays green.
OPENCODE_API_KEY=
