          "dirs",
          "eps",
          "scan",
          "epprov",
          "ptrans",
          "dedupe",
          "registry"
        ],
        "note": "Every provider lists jobs, provider transforms run in order, then names are checked for collisions across providers."
      },
      {
        "id": "config-precedence",
        "label": "Config precedence",
        "focus": [
          "cli",
          "env",
          "files",
          "chain",
          "engine"
        ],
        "note": "ResolutionChain consults sources in a fixed order. The first source returning a non-None value wins and its provenance is recorded."
      },
      {
        "id": "collision-guard",
        "label": "Where it can fail",
        "focus": [
          "ptrans",
          "dedupe",
          "registry"
        ],
        "note": "A duplicate job name across two providers raises rather than silently shadowing one of them."
      }
    ]
