{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Application Boot Sequence",
    "subtitle": "_app/boot.py wires every layer in six ordered phases, then freezes the registry before anything can run",
    "output": "docs/diagrams/boot-sequence.html",
    "quality_profile": "showcase",
    "animation": "none",
    "visual_preset": "signal-flow",
    "viewBox": [
      1000,
      1020
    ],
    "views": [
      {
        "id": "wiring",
        "label": "Wiring the layers",
        "focus": [
          "boot",
          "discovery",
          "config",
          "plugins"
        ],
        "note": "Boot is the only component that talks to every peer layer. The peers never reach for each other."
      },
      {
        "id": "freeze",
        "label": "The freeze point",
        "focus": [
          "boot",
          "di",
          "events"
        ],
        "note": "After REGISTRY_FROZEN no further provide() calls are accepted, so every later resolution sees the same registry."
      },
      {
        "id": "handover",
        "label": "Handover to the adapter",
        "focus": [
          "user",
          "app",
          "events"
        ],
        "note": "APP_READY is emitted before the adapter takes over delivery, so listeners observe a fully wired app."
      }
    ]
  },
